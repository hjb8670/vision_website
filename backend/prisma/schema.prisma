// Vision Prediction Market — Demo MVP schema (see demo-mvp-scope.md §6)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Outcome {
  YES
  NO
}

enum OrderSide {
  BUY
  SELL
}

enum MarketStatus {
  OPEN
  CLOSED
  RESOLVED
}

enum LedgerType {
  SEED
  TRADE
  PAYOUT
  DEPOSIT
  BONUS
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum NotificationType {
  MARKET
  SOCIAL
  SYSTEM
}

enum ReportContentType {
  POST
  PREDICTION
  COMMENT
  USER
}

enum ReportReason {
  SPAM
  HARASSMENT
  MISINFORMATION
  ADULT_CONTENT
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  username         String       @unique
  passwordHash     String?
  authProvider     AuthProvider @default(EMAIL)
  providerId       String?
  role             Role         @default(USER)
  bio              String?
  avatarUrl        String?
  twoFactorEnabled Boolean      @default(false)
  referralCode     String?      @unique
  referredById     String?
  referredBy       User?        @relation("Referrals", fields: [referredById], references: [id])
  referrals        User[]       @relation("Referrals")
  createdAt        DateTime     @default(now())

  wallet         Wallet?
  positions      Position[]
  orders         Order[]
  posts          Post[]
  comments       Comment[]
  likes          Like[]
  postComments   PostComment[]
  following      Follow[]              @relation("Follower")
  followers      Follow[]              @relation("Following")
  blocking       Block[]               @relation("Blocker")
  blockedBy      Block[]               @relation("Blocked")
  reports        Report[]              @relation("Reporter")
  supportTickets SupportTicket[]
  notifications  Notification[]
  passwordResets PasswordResetToken[]
}

model Wallet {
  id      String @id @default(uuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id])
  balance Float  @default(0)

  ledger WalletLedger[]
}

model WalletLedger {
  id        String     @id @default(uuid())
  walletId  String
  wallet    Wallet     @relation(fields: [walletId], references: [id])
  amount    Float
  type      LedgerType
  note      String?
  createdAt DateTime   @default(now())
}

model Category {
  id      String   @id @default(uuid())
  name    String   @unique
  slug    String   @unique
  markets Market[]
}

model Market {
  id                String       @id @default(uuid())
  slug              String       @unique
  question          String
  description       String
  resolutionSource  String
  categoryId        String
  category          Category     @relation(fields: [categoryId], references: [id])
  imageUrl          String?
  closeDate         DateTime
  status            MarketStatus @default(OPEN)
  resolvedOutcome   Outcome?
  qYes              Float        @default(0)
  qNo               Float        @default(0)
  liquidityB        Float        @default(75)
  createdAt         DateTime     @default(now())

  positions   Position[]
  orders      Order[]
  pricePoints PricePoint[]
  comments    Comment[]

  @@index([categoryId])
  @@index([status])
}

model Position {
  id             String  @id @default(uuid())
  userId         String
  user           User    @relation(fields: [userId], references: [id])
  marketId       String
  market         Market  @relation(fields: [marketId], references: [id])
  outcome        Outcome
  quantity       Float   @default(0)
  avgEntryPrice  Float   @default(0)

  @@unique([userId, marketId, outcome])
}

model Order {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  marketId  String
  market    Market    @relation(fields: [marketId], references: [id])
  outcome   Outcome
  side      OrderSide
  quantity  Float
  cost      Float
  price     Float
  createdAt DateTime  @default(now())

  @@index([marketId])
  @@index([userId])
}

model PricePoint {
  id              String   @id @default(uuid())
  marketId        String
  market          Market   @relation(fields: [marketId], references: [id])
  timestamp       DateTime
  yesProbability  Float
  volume          Float    @default(0)

  @@index([marketId, timestamp])
}

model PaymentHandoffToken {
  id         String    @id @default(uuid())
  token      String    @unique
  userId     String
  purpose    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Post {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  text      String
  images    String[]
  sentiment String?
  tags      String[]
  createdAt DateTime @default(now())

  likes         Like[]
  postComments  PostComment[]

  @@index([userId])
  @@index([createdAt])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model PostComment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  marketId  String
  market    Market   @relation(fields: [marketId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([marketId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id])
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Report {
  id          String            @id @default(uuid())
  reporterId  String
  reporter    User              @relation("Reporter", fields: [reporterId], references: [id])
  contentId   String
  contentType ReportContentType
  reason      ReportReason
  status      ReportStatus      @default(OPEN)
  createdAt   DateTime          @default(now())

  @@index([reporterId])
  @@index([contentId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

model SupportTicket {
  id        String                @id @default(uuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id])
  subject   String
  message   String
  priority  SupportTicketPriority @default(NORMAL)
  status    SupportTicketStatus   @default(OPEN)
  createdAt DateTime              @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  token      String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}
