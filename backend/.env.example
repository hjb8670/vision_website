DATABASE_URL="postgresql://vision_app:vision_dev_pw@localhost:5432/vision_demo?schema=public"
JWT_SECRET="dev-secret-change-me"
PORT=3000
# Production only: comma-separated list of allowed frontend origins for CORS.
# Leave unset in local dev to allow any origin. Also used to build Stripe success/cancel URLs.
FRONTEND_URL="https://visionprediction.com"

# Stripe (test mode keys — get from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/wallet/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=""

# Firebase Admin service account (same Firebase project as GOOGLE_SIGN_IN_WEB_CLIENT_ID in the mobile app)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Apple Sign In — the app's bundle ID / Services ID used as the token audience
APPLE_CLIENT_ID=""

# Resend (password-reset emails) — https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Vision <no-reply@visionprediction.com>"
